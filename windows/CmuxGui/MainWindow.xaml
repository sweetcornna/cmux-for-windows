<Window
    x:Class="CmuxGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CmuxGui.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="cmux">

    <!-- The backdrop is assigned in code so it can follow the Mica / Acrylic /
         None setting instead of being fixed at markup time. -->

    <Grid x:Name="RootGrid">
        <!-- Window background layers, beneath all chrome: solid colour, then
             image, then a scrim that keeps the chrome legible over a photo. -->
        <Image x:Name="AppBackgroundImage" Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Rectangle x:Name="AppBackgroundMask" />

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Draggable title bar region, so the caption blends into the app. -->
        <!-- Background is required: an element with no brush does not take part
             in hit testing, so the drag region would be unclickable. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="12,0,0,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/TitleBarIcon.png" Width="16" Height="16" />
                <TextBlock Text="cmux" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="280"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="NavSearch" QueryIcon="Find" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader x:Name="WorkspacesHeader" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,8">
                    <Button x:Name="NewWorkspaceButton" Click="OnAddWorkspace">
                        <SymbolIcon Symbol="Add" />
                    </Button>
                    <Button x:Name="CloseWorkspaceButton" Click="OnCloseWorkspace">
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <ContentControl
                    x:Name="WorkspaceHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />

                <!-- Settings keeps the workspace mounted but hides its surface,
                     so terminal processes continue without showing through. -->
                <Frame x:Name="SettingsFrame" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
        </Grid>
    </Grid>
</Window>
