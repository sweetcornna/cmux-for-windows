<Page
    x:Class="CmuxGui.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- One card shape for every row, so the page reads as a single system
             rather than a stack of bespoke controls. -->
        <Style x:Key="Card" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="36,20,36,32"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="2" MaxWidth="1000" HorizontalAlignment="Stretch">

            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,18" />

            <!-- Appearance -->
            <TextBlock x:Name="AppearanceHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,10,0,6" />

            <Expander Style="{StaticResource Card}" IsExpanded="True">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeLabel" />
                            <TextBlock x:Name="ThemeDesc" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Grid.Column="2" MinWidth="200"
                                  SelectionChanged="OnThemeChanged" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="14" Padding="0,10">
                    <ComboBox x:Name="AppThemeCombo" MinWidth="200" SelectionChanged="OnAppThemeChanged" />
                    <ComboBox x:Name="BackdropCombo" MinWidth="200" SelectionChanged="OnBackdropChanged" />
                    <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100"
                            ValueChanged="OnOpacityChanged" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TermBgLabel" VerticalAlignment="Center" />
                        <Button x:Name="TermBgButton" Grid.Column="1" MinWidth="120">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="TermBgPicker" IsAlphaEnabled="False"
                                                 IsHexInputVisible="True"
                                                 ColorChanged="OnTermBgChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TermFgLabel" VerticalAlignment="Center" />
                        <Button x:Name="TermFgButton" Grid.Column="1" MinWidth="120">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="TermFgPicker" IsAlphaEnabled="False"
                                                 IsHexInputVisible="True"
                                                 ColorChanged="OnTermFgChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AccentLabel" VerticalAlignment="Center" />
                        <Button x:Name="AccentButton" Grid.Column="1" MinWidth="120">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False"
                                                 IsHexInputVisible="True"
                                                 ColorChanged="OnAccentChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Button x:Name="ResetAppearanceButton" Click="OnResetAppearance"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>

            <!-- Background image -->
            <Expander Style="{StaticResource Card}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xEB9F;" FontSize="18" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BackgroundLabel" />
                            <TextBlock x:Name="BackgroundPathText" Style="{StaticResource CaptionTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button x:Name="ChooseImageButton" Click="OnChooseImage" />
                            <Button x:Name="ClearImageButton" Click="OnClearImage" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="14" Padding="0,10">
                    <Slider x:Name="ImageOpacitySlider" Minimum="0" Maximum="100"
                            ValueChanged="OnImageOpacityChanged" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TermMaskLabel" VerticalAlignment="Center" />
                        <Button x:Name="TermMaskButton" Grid.Column="1" MinWidth="120">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="TermMaskPicker" IsAlphaEnabled="False"
                                                 IsHexInputVisible="True"
                                                 ColorChanged="OnTermMaskChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Slider x:Name="TermMaskOpacitySlider" Minimum="0" Maximum="100"
                            ValueChanged="OnTermMaskOpacityChanged" />
                </StackPanel>
            </Expander>

            <!-- Application background -->
            <Expander Style="{StaticResource Card}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AppBackgroundLabel" />
                            <TextBlock x:Name="AppBackgroundPathText" Style="{StaticResource CaptionTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button x:Name="ChooseAppImageButton" Click="OnChooseAppImage" />
                            <Button x:Name="ClearAppImageButton" Click="OnClearAppImage" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="14" Padding="0,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AppBgLabel" VerticalAlignment="Center" />
                        <Button x:Name="AppBgButton" Grid.Column="1" MinWidth="120">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="AppBgPicker" IsAlphaEnabled="False"
                                                 IsHexInputVisible="True"
                                                 ColorChanged="OnAppBgChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Slider x:Name="AppImageOpacitySlider" Minimum="0" Maximum="100"
                            ValueChanged="OnAppImageOpacityChanged" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AppMaskLabel" VerticalAlignment="Center" />
                        <Button x:Name="AppMaskButton" Grid.Column="1" MinWidth="120">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="AppMaskPicker" IsAlphaEnabled="False"
                                                 IsHexInputVisible="True"
                                                 ColorChanged="OnAppMaskChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Slider x:Name="AppMaskOpacitySlider" Minimum="0" Maximum="100"
                            ValueChanged="OnAppMaskOpacityChanged" />
                </StackPanel>
            </Expander>

            <!-- Terminal -->
            <TextBlock x:Name="TerminalHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,6" />
            <Expander Style="{StaticResource Card}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8D2;" FontSize="18" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FontLabel" />
                            <TextBlock x:Name="FontDesc" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <TextBlock x:Name="FontValueText" Padding="0,10"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Expander>

            <!-- Windows integration -->
            <TextBlock x:Name="IntegrationHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,6" />

            <!-- A plain row, not an Expander: an Expander header is a
                 ToggleButton and swallows clicks aimed at controls inside it,
                 which is why the switch never toggled. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE71D;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ContextMenuLabel" />
                            <TextBlock x:Name="ContextMenuDesc" Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ContextMenuToggle" Grid.Column="2"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Toggled="OnContextMenuToggled" />
                    </Grid>
                    <TextBlock x:Name="ContextMenuStatus" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Language -->
            <Expander Style="{StaticResource Card}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xF2B7;" FontSize="18" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LanguageLabel" />
                            <TextBlock x:Name="LanguageDesc" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageCombo" Grid.Column="2" MinWidth="200"
                                  SelectionChanged="OnLanguageChanged" />
                    </Grid>
                </Expander.Header>
                <TextBlock Padding="0,10" Visibility="Collapsed" />
            </Expander>

            <!-- About -->
            <TextBlock x:Name="AboutHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,6" />
            <Expander Style="{StaticResource Card}">
                <Expander.Header>
                    <StackPanel Padding="0,10">
                        <TextBlock Text="cmux for Windows" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="6" Padding="0,10">
                    <TextBlock x:Name="AboutDesc" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="ProjectLinkButton"
                                     NavigateUri="https://github.com/sweetcornna/cmux-for-windows"
                                     Padding="0" HorizontalAlignment="Left" />
                    <TextBlock x:Name="LegalNoticeText" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
