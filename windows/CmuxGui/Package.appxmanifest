<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Publisher must match the signing certificate's subject exactly, or the
       package fails validation. This is CN=cmux Development.

       The Explorer context-menu extension is deliberately absent: it needs an
       IExplorerCommand COM server, and a manifest referencing a DLL that does
       not exist yet fails packaging. Identity and signing are proved first. -->
  <Identity
    Name="cmux.Windows"
    Publisher="CN=cmux Development"
    Version="0.2.1.0" />

  <Properties>
    <DisplayName>cmux for Windows</DisplayName>
    <PublisherDisplayName>sweetcornna</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-Hans" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="CmuxGui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="cmux for Windows"
        Description="An independently maintained Ghostty-based terminal for Windows"
        BackgroundColor="#1B1B1D"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
