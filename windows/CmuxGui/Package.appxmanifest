<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop4 desktop5 com rescap">

  <!-- Publisher must match the signing certificate's subject exactly, or the
       package fails validation. This is CN=cmux Development. -->
  <Identity
    Name="cmux.Windows"
    Publisher="CN=cmux Development"
    Version="0.3.3.0" />

  <Properties>
    <DisplayName>cmux for Windows</DisplayName>
    <PublisherDisplayName>sweetcornna</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-Hans" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="CmuxGui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="cmux for Windows"
        Description="An independently maintained Ghostty-based terminal for Windows"
        BackgroundColor="#1B1B1D"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer AppId="9B27DF23-B443-4DAD-A126-29A2788D5DF2" DisplayName="cmux Explorer command">
              <com:Class
                Id="9B27DF23-B443-4DAD-A126-29A2788D5DF2"
                Path="CmuxShellExtension.dll"
                ThreadingModel="STA" />
              <com:Class
                Id="7F24896E-79F7-44F3-B5F7-7A3E6202496B"
                Path="CmuxShellExtension.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb
                Id="cmuxOpenWindow"
                Clsid="9B27DF23-B443-4DAD-A126-29A2788D5DF2" />
              <desktop5:Verb
                Id="cmuxOpenWorkspace"
                Clsid="7F24896E-79F7-44F3-B5F7-7A3E6202496B" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
