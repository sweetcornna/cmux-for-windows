<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CmuxGui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Unpackaged: the app runs from a plain folder like the TUI binary does,
         instead of requiring MSIX installation for a dev build. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained: the installed WindowsAppRuntime 1.6 (6000.519.329.0)
         is older than this package expects, and the bootstrapper fails with
         0x80670016 rather than falling back. Carrying our own copy makes the
         app independent of whatever runtime a given machine happens to have. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Single-project MSIX. Packaging by hand from a publish drop silently
         loses the compiled XAML (*.xbf) and the app's resource index, and the
         result crashes inside Microsoft.UI.Xaml.dll before reaching Main.
         Only windows\scripts\package.ps1 turns packaging on, so an ordinary
         build still produces the unpackaged dev app. -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- Only when packaging. Declaring the manifest while WindowsPackageType is
       None is an outright configuration error, so an ordinary dev build must
       not see this item at all. package.ps1 supplies the property. -->
  <ItemGroup Condition="'$(WindowsPackageType)' != 'None'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
  </ItemGroup>

  <!-- Localized strings live in Strings\<lang>\Resources.resw. They need no
       ItemGroup: the SDK includes .resw as PRIResource by default, and listing
       them again is a duplicate-item error once MSIX tooling is on. Windows
       picks the closest match to the user's language list at runtime, with
       en-US as the fallback. -->

  <!-- Package tile and Start menu icons. These have to be Content, not loose
       files: Package.appxmanifest names them by path, and makeappx fails
       validation if the payload does not actually contain them. -->
  <ItemGroup>
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Bundled Ghostty-format themes, so theme switching works without a
       Ghostty install. User themes in %APPDATA%\ghostty\themes take priority. -->
  <ItemGroup>
    <Content Include="Assets\Themes\*.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The engine. Built by cargo; copied next to the app so P/Invoke finds it. -->
  <ItemGroup>
    <None Include="..\..\cmux-tui\target\x86_64-pc-windows-gnu\debug\cmux_ffi.dll"
          Condition="Exists('..\..\cmux-tui\target\x86_64-pc-windows-gnu\debug\cmux_ffi.dll')">
      <Link>cmux_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
