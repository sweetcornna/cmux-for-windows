<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

  <Identity
    Name="cmux.Windows.ShellIntegration"
    Publisher="CN=cmux Development"
    Version="0.2.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>cmux Explorer integration</DisplayName>
    <PublisherDisplayName>sweetcornna</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-Hans" />
  </Resources>

  <Applications>
    <Application
      Id="ShellIntegration"
      Executable="CmuxGui.exe"
      uap10:RuntimeBehavior="win32App"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="cmux Explorer integration"
        Description="Adds Open in cmux to File Explorer"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer AppId="9B27DF23-B443-4DAD-A126-29A2788D5DF2" DisplayName="cmux Explorer command">
              <com:Class
                Id="9B27DF23-B443-4DAD-A126-29A2788D5DF2"
                Path="CmuxShellExtension.dll"
                ThreadingModel="STA" />
              <com:Class
                Id="7F24896E-79F7-44F3-B5F7-7A3E6202496B"
                Path="CmuxShellExtension.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb
                Id="cmuxOpenWindow"
                Clsid="9B27DF23-B443-4DAD-A126-29A2788D5DF2" />
              <desktop5:Verb
                Id="cmuxOpenWorkspace"
                Clsid="7F24896E-79F7-44F3-B5F7-7A3E6202496B" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
